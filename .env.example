# Saathi — copy to .env and fill in. .env is gitignored; never commit it.
#   cp .env.example .env

# ---- Azure Speech (STT + TTS) -------------------------------------------
# Portal > Create resource > "Speech service" > Keys and Endpoint.
# Region must be the short slug, e.g. centralindia / eastus / westeurope
# (NOT the display name "Central India").
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=centralindia

# ---- Gemini (LLM) -------------------------------------------------------
# aistudio.google.com/apikey — free tier, no card.
GOOGLE_API_KEY=

# ---- Voice & language ----------------------------------------------------
# Indian-English female, warm. Alternatives worth auditioning:
#   en-IN-AshwiniNeural, en-IN-PrabhatNeural (m),
#   hi-IN-SwaraNeural            <- Hindi
#   en-US-JennyMultilingualNeural <- Hindi/English code-switching
# Verify any voice exists in Speech Studio > Voice Gallery for YOUR region.
SAATHI_TTS_VOICE=en-IN-NeerjaNeural
SAATHI_TTS_LANGUAGE=en-IN
SAATHI_STT_LANGUAGE=en-IN

# Optional expressive style (only for voices that support one — check the
# Voice Gallery; e.g. NeerjaNeural supports "empathetic"). Leave empty to skip.
SAATHI_TTS_STYLE=
# Speaking rate. 1.0 = the voice's natural pace.
SAATHI_TTS_RATE=1.0

# ---- LLM provider ---------------------------------------------------------
# "azure" = Azure OpenAI (recommended: real rate limits, one vendor, runs the
# understander too). "gemini" = Google AI Studio (free tier: 20 requests/day
# per model — fine for a quick poke, unusable for real testing).
# "openai" also covers GitHub Models — free for anyone with a GitHub account,
# ~150 requests/day on mini models, no card. Azure-for-Students subscriptions
# are NOT eligible for Azure OpenAI (Microsoft-side gating).
SAATHI_LLM_PROVIDER=gemini
# Required when SAATHI_LLM_PROVIDER=azure (needs Pay-As-You-Go subscription):
#AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Required when SAATHI_LLM_PROVIDER=openai. For GitHub Models:
#   token: github.com > Settings > Developer settings > Fine-grained PAT,
#   with the account-level "Models" read permission
#OPENAI_API_KEY=github_pat_...
#OPENAI_BASE_URL=https://models.github.ai/inference
#OPENAI_MODEL=openai/gpt-4o-mini

# ---- LLM tuning ---------------------------------------------------------
SAATHI_LLM_MODEL=gemini-2.5-flash
# Moderate temperature: enough variety that she never phrases two turns
# the same way; the turn plan and voice-style rules keep her on the rails.
SAATHI_LLM_TEMPERATURE=0.65

# ---- Turn-taking / barge-in --------------------------------------------
# Silence (seconds) before VAD calls the turn over. Lower = snappier but
# more likely to cut off a thinking pause. 0.2 is the Pipecat default;
# 0.4 is kinder to someone speaking about something difficult.
SAATHI_VAD_STOP_SECS=0.4

# ---- Ops ----------------------------------------------------------------
SAATHI_HELPLINE_REGION=IN
SAATHI_LOG_DIR=logs
SAATHI_HOST=localhost
SAATHI_PORT=7860
# Cloud VMs sit behind NAT: the server needs STUN to offer the browser a
# reachable address. Leave unset on localhost.
#SAATHI_ICE_SERVERS=stun:stun.l.google.com:19302
# Locks /dashboard's data (metrics + per-session drill-down) behind a Bearer
# token. Unset = open, for local development. Set on any public deployment.
#SAATHI_DASHBOARD_TOKEN=<long-random-string>

# ---- Retrieval ------------------------------------------------------------
# Fast model for query rewriting + emotion classification (one call per turn).
SAATHI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
# Passages injected per turn.
SAATHI_RAG_TOP_K=4

# ---- Alternative TTS: ElevenLabs (optional) --------------------------------
# SAATHI_TTS_PROVIDER=elevenlabs activates it; azure is the default.
# Key: elevenlabs.io -> profile -> API keys (free tier ~10k chars/month).
# Voice: pick in their Voice Library, copy the voice ID.
# eleven_flash_v2_5 = their low-latency model, supports Hindi.
#SAATHI_TTS_PROVIDER=elevenlabs
#ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=
#ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Database ---------------------------------------------------------------
# Empty = SQLite at logs/saathi.db (zero setup). For Postgres (e.g. Supabase:
# project > Connect > URI — use the session pooler string), set:
#SAATHI_DATABASE_URL=postgresql://user:pass@host:5432/postgres
