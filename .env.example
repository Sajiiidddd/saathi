# Saathi — copy to .env and fill in. .env is gitignored; never commit it.
#   cp .env.example .env

# ---- Azure Speech (STT + TTS) -------------------------------------------
# Portal > Create resource > "Speech service" > Keys and Endpoint.
# Region must be the short slug, e.g. centralindia / eastus / westeurope
# (NOT the display name "Central India").
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=centralindia

# ---- Gemini (LLM) -------------------------------------------------------
# aistudio.google.com/apikey — free tier, no card.
GOOGLE_API_KEY=

# ---- Voice & language ----------------------------------------------------
# Indian-English female, warm. Alternatives worth auditioning:
#   en-IN-AshwiniNeural, en-IN-PrabhatNeural (m),
#   hi-IN-SwaraNeural            <- Hindi
#   en-US-JennyMultilingualNeural <- Hindi/English code-switching
# Verify any voice exists in Speech Studio > Voice Gallery for YOUR region.
SAATHI_TTS_VOICE=en-IN-NeerjaNeural
SAATHI_TTS_LANGUAGE=en-IN
SAATHI_STT_LANGUAGE=en-IN

# ---- LLM tuning ---------------------------------------------------------
SAATHI_LLM_MODEL=gemini-2.5-flash
# Low temperature: she is a careful companion, not a creative writer.
SAATHI_LLM_TEMPERATURE=0.4

# ---- Turn-taking / barge-in --------------------------------------------
# Silence (seconds) before VAD calls the turn over. Lower = snappier but
# more likely to cut off a thinking pause. 0.2 is the Pipecat default;
# 0.4 is kinder to someone speaking about something difficult.
SAATHI_VAD_STOP_SECS=0.4

# ---- Ops ----------------------------------------------------------------
SAATHI_HELPLINE_REGION=IN
SAATHI_LOG_DIR=logs
SAATHI_HOST=localhost
SAATHI_PORT=7860
